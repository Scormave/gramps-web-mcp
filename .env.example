# Copy to .env next to docker-compose.yml and fill in values after Gramps Web setup.
GRAMPS_USERNAME=owner
GRAMPS_PASSWORD=change-me
GRAMPS_TREE_ID=your-tree-uuid
GRAMPS_READ_ONLY=false
# Recommended when MCP port is reachable from other machines (min 16 chars; generate with: openssl rand -base64 32)
MCP_API_KEY=
