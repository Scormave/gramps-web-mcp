# Copy to .env next to docker-compose.yml and fill in values after Gramps Web setup.
#
# Required (compose reads these from .env)
GRAMPS_USERNAME=owner
GRAMPS_PASSWORD=change-me
# Or, when Gramps Web has password login turned off, a refresh token instead
# of GRAMPS_USERNAME and GRAMPS_PASSWORD (see README)
# GRAMPS_REFRESH_TOKEN=
GRAMPS_TREE_ID=your-tree-uuid
GRAMPS_READ_ONLY=false

# Optional — SQLite-friendly write pacing (serialize is on by default)
# GRAMPS_MUTATION_SERIALIZE=true
# GRAMPS_MUTATION_MIN_INTERVAL_MS=250

# Optional — ask the user before delete_object and undo_change change the tree
# (when-supported, required or off). Needs MCP_STATELESS=false over HTTP.
# GRAMPS_CONFIRMATION=when-supported

# Recommended when MCP port is reachable from other machines
# (min 16 chars; generate with: openssl rand -base64 32)
MCP_API_KEY=

# Optional — browser origins allowed to call the MCP port, comma-separated.
# Requests from any other browser origin get 403; clients outside a browser
# send no Origin and need nothing here.
# MCP_ALLOWED_ORIGINS=https://app.example.com

# Optional — media file access, also needed for uploads (disabled by default)
# GRAMPS_MEDIA_RESOURCES_ENABLED=false
# GRAMPS_MEDIA_MAX_BYTES=5242880
# GRAMPS_MEDIA_ALLOW_PRIVATE=false

# Optional — upload photos and scans with create_media (off while unset).
# Uploading also needs GRAMPS_MEDIA_RESOURCES_ENABLED=true.
# Folders as seen inside the container; mount them in docker-compose.yml.
# GRAMPS_MEDIA_UPLOAD_DIRS=/uploads
# GRAMPS_MEDIA_UPLOAD_MAX_BYTES=52428800

# Optional — log level; Debug and Trace also log genealogy data from API bodies
# GRAMPS_LOG_LEVEL=Information

# Optional — transport overrides (Docker image defaults shown)
# GRAMPS_API_URL is set to http://grampsweb:5000 in docker-compose.example.yml
# GRAMPS_API_URL=http://grampsweb:5000
# MCP_TRANSPORT=http
# ASPNETCORE_URLS=http://0.0.0.0:8080
# MCP_PATH=/mcp
# MCP_STATELESS=true
# MCP_ENABLE_LEGACY_SSE=false
